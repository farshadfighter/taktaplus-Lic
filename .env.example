# Copy to .env for local development (never commit .env).
TPLIC_LISTEN=:8080
TPLIC_DATABASE_URL=postgres://taktaplus_lic:taktaplus_lic@localhost:5433/taktaplus_lic?sslmode=disable
TPLIC_LOG_LEVEL=debug
# 32 random bytes, base64 (head -c32 /dev/urandom | base64). Keep it secret.
TPLIC_MASTER_KEY=
# Only for local development over plain HTTP.
TPLIC_COOKIE_SECURE=false
